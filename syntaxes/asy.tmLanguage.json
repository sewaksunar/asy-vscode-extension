{
  "scopeName": "source.asy",
  "name": "Asymptote",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#functions" },
    { "include": "#types" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.asy",
          "match": "//.*$"
        },
        {
          "name": "comment.block.asy",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.asy",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.asy",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.asy",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.asy",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.asy",
          "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.asy",
          "match": "\\b(?:if|else|for|while|return|break|continue|switch|case|default|struct|class|typedef|import|from|using|namespace)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.asy",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.asy",
          "match": "\\b(?:int|real|bool|string|void|path|pair|guide|picture)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.asy",
          "match": "[+\\-*/%=<>!]+|\\b(?:and|or|not)\\b"
        }
      ]
    }
  }
}
