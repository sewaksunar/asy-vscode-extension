{
  "name": "asy-vscode-extension",
  "displayName": "Asy VSCode Extension",
  "description": "Build and preview Asymptote (.asy) files from within Visual Studio Code.",
  "version": "0.0.1",
  "publisher": "vscode-asymptote",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sewaksunar/asy-vscode-extension"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:asymptoteCommandsView",
    "onView:asymptoteStructureView",
    "onView:asymptoteSymbolsView"
  ],
  "files": [
    "out/**",
    "src/extension.ts",
    "README.md",
    "syntaxes/**",
    "media/**",
    "LICENSE"
  ],
  "contributes": {
    "configuration": {
      "title": "Asymptote Build",
      "properties": {
        "asymptoteBuild.executablePath": {
          "type": "string",
          "default": "asy",
          "description": "Path to the Asymptote executable."
        },
        "asymptoteBuild.outputFormat": {
          "type": "string",
          "default": "jpg",
          "description": "Output format passed to the Asymptote -f option."
        },
        "asymptoteBuild.extraArgs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional arguments passed to the Asymptote command."
        },
        "asymptoteBuild.showOutputOnBuild": {
          "type": "boolean",
          "default": true,
          "description": "Automatically show the output channel when a build is triggered."
        },
        "asymptoteBuild.timeout": {
          "type": "number",
          "default": 30000,
          "description": "Timeout in milliseconds for the Asymptote build process. Set to 0 to disable."
        }
      }
    },
    "commands": [
      {
        "command": "asymptoteBuild.showSidebar",
        "title": "Asymptote: Show Sidebar",
        "category": "Asymptote"
      },
      {
        "command": "asymptoteBuild.exportPdfAndOpen",
        "title": "Asymptote: Render JPG",
        "category": "Asymptote",
        "icon": {
          "light": "media/render.svg",
          "dark": "media/render.svg"
        }
      },
      {
        "command": "asymptoteBuild.exportWithOptions",
        "title": "Asymptote: Detailed Export",
        "category": "Asymptote",
        "icon": {
          "light": "media/render-drop.svg",
          "dark": "media/render-drop.svg"
        }
      },
      {
        "command": "asymptoteBuild.previewWithOptions",
        "title": "Asymptote: Detailed Preview",
        "category": "Asymptote",
        "icon": {
          "light": "media/preview-drop.svg",
          "dark": "media/preview-drop.svg"
        }
      },
      {
        "command": "asymptoteBuild.exportAsSvg",
        "title": "Asymptote: Export as SVG",
        "category": "Asymptote"
      },
      {
        "command": "asymptoteBuild.exportAsJpg",
        "title": "Asymptote: Export as JPG",
        "category": "Asymptote"
      },
      {
        "command": "asymptoteBuild.exportAsEps",
        "title": "Asymptote: Export as EPS",
        "category": "Asymptote"
      },
      {
        "command": "asymptoteBuild.previewToRight",
        "title": "Asymptote: Open Preview to Right",
        "category": "Asymptote",
        "icon": {
          "light": "media/preview-dark.svg",
          "dark": "media/preview-dark.svg"
        }
      }
    ],
    "submenus": [],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "asymptoteBuildContainer",
          "title": "Asymptote",
          "icon": "media/asymptote.svg"
        }
      ]
    },
    "views": {
      "asymptoteBuildContainer": [
        {
          "id": "asymptoteCommandsView",
          "name": "Commands"
        },
        {
          "id": "asymptoteStructureView",
          "name": "Structure"
        },
        {
          "id": "asymptoteSymbolsView",
          "name": "Symbols / Palette"
        }
      ]
    },
    "languages": [
      {
        "id": "asy",
        "aliases": [
          "Asymptote",
          "asy"
        ],
        "extensions": [
          ".asy"
        ],
        "configuration": "./syntaxes/language-configuration.json",
        "icon": {
          "light": "media/asymptote.svg",
          "dark": "media/asymptote.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "asy",
        "scopeName": "source.asy",
        "path": "./syntaxes/asy.tmLanguage.json"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "asymptoteBuild.exportPdfAndOpen",
          "when": "resourceExtname == .asy",
          "group": "navigation@1"
        },
        {
          "command": "asymptoteBuild.exportWithOptions",
          "when": "resourceExtname == .asy",
          "group": "navigation@1"
        },
        {
          "command": "asymptoteBuild.previewToRight",
          "when": "resourceExtname == .asy",
          "group": "navigation@1"
        },
        {
          "command": "asymptoteBuild.previewWithOptions",
          "when": "resourceExtname == .asy",
          "group": "navigation@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/vsce": "^3.9.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  }
}
